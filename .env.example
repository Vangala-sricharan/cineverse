# GEMINI_API_KEY: Required for Gemini AI API calls.
# Read strictly server-side by serverless API handlers (/api/gemini).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDB_READ_ACCESS_TOKEN: The Movie Database (TMDB) v4 API Read Access Token.
# Sent strictly server-side as 'Authorization: Bearer <TOKEN>'.
TMDB_READ_ACCESS_TOKEN="MY_TMDB_READ_ACCESS_TOKEN"
